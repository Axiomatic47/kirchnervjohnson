{
  "name": "kirchnervjohnson",
  "version": "0.1.0",
  "private": true,
  "description": "kirchnervjohnson.com \u2014 Kirchner v. Johnson, No. 1:25-cv-02735-ACR (D.D.C.): the filings in review mode, every citation linked to its source in two panes \u2014 the Studio's Case Review window, vendored, differing in skin alone (static Next.js export on Netlify)",
  "scripts": {
    "dev": "next dev",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "casereview:check": "node scripts/sync-casereview.mjs --check && node scripts/import-casereview.mjs --check",
    "casereview:sync": "node scripts/sync-casereview.mjs --sync && node scripts/sync-casereview.mjs --check --source",
    "casereview:import": "node scripts/import-casereview.mjs",
    "build": "npm run typecheck && npm run casereview:check && next build",
    "start": "npx serve out"
  },
  "dependencies": {
    "next": "^16.2.10",
    "react": "^19.2.7",
    "react-dom": "^19.2.7"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "autoprefixer": "^10.4.17",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.2.10",
    "postcss": "^8.4.33",
    "serve": "^14.2.6",
    "tailwindcss": "^3.4.1",
    "typescript": "^5.2.2"
  },
  "engines": {
    "node": ">=22"
  }
}
